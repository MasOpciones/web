---
import BaseLayout from "./BaseLayout.astro";
import {
  AUTHOR,
  absoluteUrl,
  getAuthorPersonJsonLd,
  isMarioSalasSandi,
  resolveAuthorName,
} from "../lib/site";

interface Props {
  title: string;
  description?: string;
  pubDate?: string | Date;
  updatedDate?: string | Date;
  author?: string;
  ogImage?: string;
}

const { title, description, pubDate, updatedDate, author, ogImage } = Astro.props;

const resolvedAuthor = resolveAuthorName(author);
const isAuthorProfileLinked = isMarioSalasSandi(resolvedAuthor);
const authorJsonLd = isAuthorProfileLinked
  ? getAuthorPersonJsonLd()
  : { "@type": "Person", name: resolvedAuthor };
const ogImageAbsolute = ogImage ? absoluteUrl(ogImage) : undefined;
const canonical = absoluteUrl(Astro.url.pathname);
const dateModified = updatedDate ?? pubDate;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  ...(description && { description }),
  ...(pubDate && { datePublished: new Date(pubDate).toISOString() }),
  ...(dateModified && { dateModified: new Date(dateModified).toISOString() }),
  author: authorJsonLd,
  publisher: { "@type": "Organization", name: "MásOpciones", url: absoluteUrl("/") },
  url: canonical,
  ...(ogImageAbsolute && { image: ogImageAbsolute }),
});

function formatDate(date: string | Date | undefined) {
  if (!date) return "";
  return new Date(date).toLocaleDateString("es-CR", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
}
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  ogImage={ogImageAbsolute}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </Fragment>
  <main>
    <section class="container" style="max-width: 720px;">
      <div class="topbar">
        <a href="/" class="logo-link" aria-label="Ir al inicio de MásOpciones">
          <img
            data-site-logo
            src="/logo-blanco.svg"
            alt="MásOpciones"
            class="site-logo"
          />
        </a>

        <button
          class="theme-toggle"
          onclick="toggleTheme()"
          aria-label="Cambiar tema"
          title="Cambiar tema"
        >
          <span data-theme-icon aria-hidden="true"></span>
        </button>
      </div>

      <article style="padding-bottom: 4rem;">
        <header style="margin-bottom: 3rem;">
          <p class="eyebrow" style="margin-bottom: 1rem;">ANÁLISIS</p>

          <h1
            class="hero-title"
            style="font-size: clamp(2.2rem, 4vw, 3.5rem); line-height: 1.02;"
          >
            {title}
          </h1>

          {description && (
            <p class="lead" style="margin-top: 1.2rem;">
              {description}
            </p>
          )}

          {(pubDate || isAuthorProfileLinked) && (
            <p class="muted" style="margin-top: 1rem;">
              {pubDate && (
                <time datetime={new Date(pubDate).toISOString()}>
                  {formatDate(pubDate)}
                </time>
              )}
              {isAuthorProfileLinked && (
                <>
                  {pubDate && " · "}
                  Por <a href={AUTHOR.path} rel="author">{AUTHOR.name}</a>
                </>
              )}
            </p>
          )}
        </header>

        <div class="prose">
          <slot />
        </div>
      </article>

      <footer class="site-footer-minimal">
        <a href="/about">About</a>
      </footer>
    </section>
  </main>
</BaseLayout>
